---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getContent, social } from '../i18n/content';

const t = getContent('es');
const services = t.services.items;
const languages = ['ES', 'EN', 'PT'];
---

<Layout
  lang="es"
  htmlLang="es"
  title="Panel administrador | AVC Soluciones Empresariales"
  description="Panel interno para administrar perfiles asociados a los servicios de AVC Soluciones Empresariales."
>
  <main class="admin-shell min-h-screen bg-ink-950 text-cream">
    <section class="admin-login-screen" data-login-screen>
      <div class="admin-login-card">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-gold-300 hover:text-gold-200 transition">
          <Icon name="arrow" class="h-4 w-4 rotate-180" /> Volver al sitio
        </a>

        <div class="mt-8">
          <p class="eyebrow !text-gold-300">Acceso interno</p>
          <h1 class="mt-4 text-4xl leading-tight">Panel administrador</h1>
          <p class="mt-4 text-sm leading-relaxed text-cream/62">
            Ingresa con tu usuario para administrar perfiles del equipo y revisar las estadísticas principales de la web.
          </p>
        </div>

        <form class="mt-8 space-y-4" data-login-form>
          <label class="block">
            <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Usuario</span>
            <input
              class="admin-input mt-2"
              name="username"
              type="text"
              autocomplete="username"
              required
              placeholder="admin"
            />
          </label>

          <label class="block">
            <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Contraseña</span>
            <input
              class="admin-input mt-2"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="********"
            />
          </label>

          <p class="hidden rounded-xl border border-red-400/25 bg-red-400/10 px-3 py-2 text-sm text-red-100" data-login-error>
            Usuario o contraseña incorrectos.
          </p>

          <button type="submit" class="btn btn-gold w-full justify-center">Ingresar</button>
        </form>
      </div>
    </section>

    <section class="hidden" data-admin-app>
      <header class="relative overflow-hidden border-b border-white/10">
        <div class="absolute inset-0 bg-[radial-gradient(55%_70%_at_72%_0%,rgba(212,175,55,0.16),transparent)]"></div>
        <div class="container-x relative py-10 sm:py-14">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-2xl">
              <a href="/" class="admin-back-link">
                <Icon name="arrow" class="h-4 w-4 rotate-180" /> Volver al sitio
              </a>
              <p class="admin-section-kicker eyebrow !text-gold-300">Panel administrador</p>
              <h1 class="mt-4 text-4xl sm:text-5xl leading-tight">Dashboard y equipo por servicio</h1>
              <p class="mt-4 text-cream/70 leading-relaxed">
                Controla las fichas profesionales que aparecen en el sitio público y asigna integrantes a cada servicio.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full border border-gold-400/25 bg-gold-400/10 px-3 py-1.5 text-xs font-semibold text-gold-200">
                Sesión: <span data-session-user>admin</span>
              </span>
              <button type="button" class="btn btn-outline !py-2 !px-4 text-sm" data-logout>Cerrar sesión</button>
            </div>
          </div>
        </div>
      </header>

      <section class="container-x pt-9 sm:pt-12">
        <section class="admin-traffic-hero" aria-labelledby="traffic-title">
          <div class="admin-world-map" aria-label="Mapa político de conexiones por país" data-world-map>
            <div class="admin-map-loading">Cargando mapa político...</div>
          </div>

          <div class="admin-traffic-copy">
            <p class="text-xs font-semibold uppercase tracking-wider text-gold-300">Tráfico global</p>
            <h2 id="traffic-title" class="mt-2 font-display text-3xl sm:text-4xl leading-tight">Mapa vivo de conexiones</h2>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-cream/62">
              Cada nueva visita respira sobre su país durante unos segundos y queda agregada para analizar las últimas horas.
            </p>

            <div class="admin-traffic-stats" aria-label="Resumen de tráfico">
              <article>
                <span>Conexiones 24 h</span>
                <strong data-traffic-total>0</strong>
              </article>
              <article>
                <span>Países activos</span>
                <strong data-traffic-countries>0</strong>
              </article>
              <article>
                <span>Principal origen</span>
                <strong data-traffic-top>Sin datos</strong>
              </article>
            </div>
          </div>

          <aside class="admin-traffic-panel">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gold-300">Últimas horas</p>
                <h3 class="mt-1 font-display text-2xl">Origen del tráfico</h3>
              </div>
              <span class="admin-live-pill" data-traffic-last>En espera</span>
            </div>

            <div class="mt-5 space-y-3" data-traffic-bars>
              <p class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-cream/45">Todavía no hay conexiones registradas.</p>
            </div>

            <button type="button" class="admin-expand-button mt-4" data-traffic-toggle aria-expanded="false">
              Ver porcentaje exacto por país
            </button>
            <button type="button" class="admin-demo-button mt-2" data-traffic-demo hidden>
              Cargar muestra local
            </button>
            <div class="admin-traffic-detail" data-traffic-detail hidden></div>
          </aside>
        </section>
      </section>

      <section class="container-x py-5 sm:py-7">
        <div class="admin-dashboard">
          <article class="admin-metric">
            <span class="admin-metric-icon"><Icon name="briefcase" class="h-5 w-5" /></span>
            <p class="admin-metric-label">Servicios publicados</p>
            <p class="admin-metric-value">{services.length}</p>
          </article>

          <article class="admin-metric">
            <span class="admin-metric-icon"><Icon name="download" class="h-5 w-5" /></span>
            <p class="admin-metric-label">Integrantes cargados</p>
            <p class="admin-metric-value" data-total-profiles>0</p>
          </article>

          <article class="admin-metric">
            <span class="admin-metric-icon"><Icon name="check" class="h-5 w-5" /></span>
            <p class="admin-metric-label">Servicios con equipo</p>
            <p class="admin-metric-value"><span data-covered-services>0</span>/{services.length}</p>
          </article>

          <article class="admin-metric">
            <span class="admin-metric-icon"><Icon name="globe" class="h-5 w-5" /></span>
            <p class="admin-metric-label">Idiomas activos</p>
            <p class="admin-metric-value">{languages.length}</p>
          </article>
        </div>

        <div class="mt-5 grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
          <section class="admin-panel p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gold-300">Cobertura de equipo</p>
                <h2 class="mt-1 font-display text-2xl">Distribución por servicio</h2>
              </div>
              <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-cream/55" data-storage-used>0 KB usados</span>
            </div>
            <div class="mt-5 space-y-3" data-service-chart>
              {services.map((service, i) => (
                <div class="admin-chart-row" data-chart-row data-service-id={`service-${i}`}>
                  <div class="flex items-center justify-between gap-3 text-sm">
                    <span class="truncate text-cream/78">{service.name}</span>
                    <span class="font-semibold text-gold-300" data-chart-count>0</span>
                  </div>
                  <div class="mt-2 h-2 overflow-hidden rounded-full bg-white/[0.06]">
                    <span class="block h-full rounded-full bg-gold-400" style="width: 0%" data-chart-bar></span>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <aside class="admin-panel p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-gold-300">Actividad</p>
            <h2 class="mt-1 font-display text-2xl">Resumen rápido</h2>

            <dl class="mt-5 space-y-4">
              <div class="admin-detail-row">
                <dt>Último perfil actualizado</dt>
                <dd data-last-upload>Sin cargas todavía</dd>
              </div>
              <div class="admin-detail-row">
                <dt>Servicio con más integrantes</dt>
                <dd data-top-service>Sin datos</dd>
              </div>
              <div class="admin-detail-row">
                <dt>Secciones públicas</dt>
                <dd>Inicio, servicios, sectores, inversionistas y contacto</dd>
              </div>
              <div class="admin-detail-row">
                <dt>Idiomas</dt>
                <dd>{languages.join(' / ')}</dd>
              </div>
            </dl>

            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/#servicios" class="btn btn-gold !py-2 !px-4 text-sm">Ver sitio público</a>
              <a href="#gestion-equipo" class="btn btn-outline !py-2 !px-4 text-sm">Gestionar equipo</a>
            </div>
          </aside>
        </div>

        <section class="admin-panel mt-5 p-5">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div class="max-w-2xl">
              <p class="text-xs font-semibold uppercase tracking-wider text-gold-300">Google Maps</p>
              <h2 class="mt-1 font-display text-2xl">Destino de los botones de dirección</h2>
              <p class="mt-2 text-sm leading-relaxed text-cream/58">
                Escribe la dirección como la buscarías en Google Maps. El sitio generará el enlace y actualizará los botones de dirección.
              </p>
            </div>
            <a
              href={social.maps}
              target="_blank"
              rel="noopener"
              class="btn btn-outline !py-2 !px-4 text-sm"
              data-location-open
            >
              Abrir destino actual
            </a>
          </div>

          <form
            class="admin-location-form mt-5"
            data-location-form
            data-default-address={t.contact.addressValue}
            data-default-maps-url={social.maps}
          >
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Dirección para Google Maps</span>
              <input
                class="admin-input mt-2"
                name="address"
                type="text"
                autocomplete="street-address"
                placeholder="Ej: Libertad entre Cerro Corá y Nicasio Villalba - Fernando de la Mora"
                data-location-address-input
              />
            </label>

            <div class="admin-location-preview">
              <span class="admin-location-icon"><Icon name="pin" class="h-5 w-5" /></span>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-wider text-cream/45">Hipervínculo generado</p>
                <a
                  href={social.maps}
                  target="_blank"
                  rel="noopener"
                  class="mt-1 block truncate text-sm font-semibold text-gold-300 hover:text-gold-200 transition"
                  data-location-url-preview
                >
                  {social.maps}
                </a>
                <p class="mt-1 text-xs text-cream/45" data-location-status>Usando la dirección original del sitio.</p>
              </div>
            </div>

            <div class="flex flex-wrap gap-3">
              <button type="submit" class="btn btn-gold !py-2 !px-4 text-sm">Guardar dirección</button>
              <button type="button" class="btn btn-outline !py-2 !px-4 text-sm" data-location-reset>Restaurar original</button>
            </div>
          </form>
        </section>
      </section>

      <section id="gestion-equipo" class="container-x pb-12 sm:pb-16">
        <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gold-300">Gestión de equipo</p>
            <h2 class="mt-1 font-display text-3xl">Perfiles profesionales</h2>
          </div>
          <p class="max-w-xl text-sm leading-relaxed text-cream/55">
            Edita la foto, el nombre, el cargo y la descripción de cada integrante. Estas fichas se reutilizan en los servicios donde estén asignadas.
          </p>
        </div>

        <div class="grid gap-5 xl:grid-cols-[0.95fr_1.05fr]">
          <section class="admin-panel p-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gold-300">Biblioteca</p>
                <h3 class="mt-1 font-display text-2xl">Integrantes editables</h3>
              </div>
              <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-cream/55" data-profile-library-count>0 perfiles</span>
            </div>
            <div class="mt-5 grid gap-4" data-profile-list></div>

            <form class="admin-profile-form mt-5 rounded-2xl border border-dashed border-gold-400/30 bg-ink-950/45 p-4" data-new-profile-form>
              <p class="text-xs font-semibold uppercase tracking-wider text-gold-300">Nuevo integrante</p>
              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <label class="block sm:col-span-2">
                  <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Nombre</span>
                  <input class="admin-input mt-2" name="name" type="text" required placeholder="Nombre del integrante" />
                </label>
                <label class="block">
                  <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Cargo</span>
                  <input class="admin-input mt-2" name="role" type="text" placeholder="Contador Público" />
                </label>
                <label class="block">
                  <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Especialidad</span>
                  <input class="admin-input mt-2" name="specialty" type="text" placeholder="Tributación y auditoría" />
                </label>
                <label class="block sm:col-span-2">
                  <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Descripción</span>
                  <textarea class="admin-input mt-2 min-h-32 resize-y" name="description" required placeholder="Resumen profesional que se verá en la web pública."></textarea>
                </label>
                <label class="block sm:col-span-2">
                  <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Imagen</span>
                  <input class="admin-file mt-2" name="image" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
                </label>
              </div>
              <button type="submit" class="btn btn-gold mt-4 !py-2 !px-4 text-sm">Crear integrante</button>
            </form>
          </section>

          <section class="admin-panel p-5">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-gold-300">Asignaciones</p>
              <h3 class="mt-1 font-display text-2xl">Integrantes por servicio</h3>
              <p class="mt-2 text-sm leading-relaxed text-cream/55">
                Selecciona por nombre los integrantes que corresponden a cada servicio y revisa cómo queda la ficha pública.
              </p>
            </div>
            <div class="mt-5 grid gap-5" data-service-assignment-list>
              {services.map((service, i) => (
                <article class="admin-service-assignment" data-admin-service data-service-id={`service-${i}`} data-service-name={service.name}>
                  <div class="admin-service-preview">
                    <div class="flex items-start gap-4">
                      <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gold-400/15 text-gold-400">
                        <Icon name={service.icon} class="h-6 w-6" />
                      </div>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-3">
                          <h4 class="font-display text-xl leading-tight">{service.name}</h4>
                          <span class="rounded-full border border-white/10 px-2.5 py-1 text-xs font-semibold text-cream/50" data-service-count>0 integrantes</span>
                        </div>
                        <p class="mt-2 text-sm leading-relaxed text-cream/65">{service.desc}</p>
                        <p class="mt-3 text-xs text-gold-300/90">
                          <span class="font-semibold uppercase tracking-wider">{t.services.targetLabel}:</span> {service.target}
                        </p>
                      </div>
                    </div>
                    <div class="mt-4" data-assigned-preview></div>
                  </div>

                  <details class="admin-assign-menu mt-4" data-profile-menu>
                    <summary>
                      <span>Asignar colaborador</span>
                    </summary>
                    <div class="admin-assign-options" data-profile-menu-options></div>
                  </details>
                </article>
              ))}
            </div>
          </section>
        </div>

        <template data-profile-card-template>
          <article class="admin-profile-card" data-profile-card>
            <form data-profile-form>
              <div class="admin-profile-edit-grid">
                <div class="admin-profile-media">
                  <img src="" alt="" class="admin-profile-image" data-profile-image />
                  <label class="mt-3 block">
                    <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Cambiar imagen</span>
                    <input class="admin-file mt-2" name="image" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
                  </label>
                </div>
                <div class="admin-profile-fields">
                  <label class="block">
                    <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Nombre</span>
                    <input class="admin-input mt-2" name="name" type="text" required />
                  </label>
                  <div class="grid gap-3">
                    <label class="block">
                      <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Cargo</span>
                      <input class="admin-input mt-2" name="role" type="text" />
                    </label>
                    <label class="block">
                      <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Especialidad</span>
                      <input class="admin-input mt-2" name="specialty" type="text" />
                    </label>
                  </div>
                  <label class="block">
                    <span class="text-xs font-semibold uppercase tracking-wider text-cream/50">Descripcion</span>
                    <textarea class="admin-input mt-2 min-h-36 resize-y" name="description" required></textarea>
                  </label>
                  <div class="flex flex-wrap gap-3">
                    <button type="submit" class="btn btn-gold !py-2 !px-4 text-sm">Guardar cambios</button>
                    <button type="button" class="btn btn-outline !py-2 !px-4 text-sm" data-delete-profile>Eliminar</button>
                  </div>
                </div>
              </div>
            </form>
          </article>
        </template>
      </section>
    </section>
  </main>
</Layout>

<script>
  const loginScreen = document.querySelector('[data-login-screen]');
  const adminApp = document.querySelector('[data-admin-app]');
  const loginForm = document.querySelector('[data-login-form]');
  const loginError = document.querySelector('[data-login-error]');
  const locationForm = document.querySelector('[data-location-form]');
  const locationAddressInput = document.querySelector('[data-location-address-input]');
  const locationUrlPreview = document.querySelector('[data-location-url-preview]');
  const locationStatus = document.querySelector('[data-location-status]');
  const locationOpen = document.querySelector('[data-location-open]');
  const defaultLocation = {
    address: locationForm?.getAttribute('data-default-address') || '',
    mapsUrl: locationForm?.getAttribute('data-default-maps-url') || '',
  };
  let teamProfiles = [];
  let teamAssignments = {};
  let currentUser = null;
  let trafficStats = null;
  let trafficPoll = null;
  let mapReady = false;
  let trafficPulseTimer = null;
  const trafficPulseQueue = [];
  const countryPulseTimeouts = new Map();
  const seenTrafficEventIds = new Set();
  const localTrafficSample = {
    hours: 24,
    total: 47,
    countries: [
      { countryCode: 'PY', countryName: 'Paraguay', count: 18, percentage: 38.3, lastSeenAt: new Date().toISOString() },
      { countryCode: 'BR', countryName: 'Brasil', count: 9, percentage: 19.1, lastSeenAt: new Date(Date.now() - 1000 * 60 * 4).toISOString() },
      { countryCode: 'US', countryName: 'Estados Unidos', count: 7, percentage: 14.9, lastSeenAt: new Date(Date.now() - 1000 * 60 * 12).toISOString() },
      { countryCode: 'AR', countryName: 'Argentina', count: 6, percentage: 12.8, lastSeenAt: new Date(Date.now() - 1000 * 60 * 22).toISOString() },
      { countryCode: 'ES', countryName: 'Espana', count: 4, percentage: 8.5, lastSeenAt: new Date(Date.now() - 1000 * 60 * 38).toISOString() },
      { countryCode: 'CL', countryName: 'Chile', count: 2, percentage: 4.3, lastSeenAt: new Date(Date.now() - 1000 * 60 * 51).toISOString() },
      { countryCode: 'UY', countryName: 'Uruguay', count: 1, percentage: 2.1, lastSeenAt: new Date(Date.now() - 1000 * 60 * 67).toISOString() },
    ],
    topCountries: [],
    recentEvents: [
      { id: 'sample-py-1', countryCode: 'PY', countryName: 'Paraguay', at: new Date().toISOString(), path: '/' },
      { id: 'sample-br-1', countryCode: 'BR', countryName: 'Brasil', at: new Date(Date.now() - 1000 * 8).toISOString(), path: '/pt' },
      { id: 'sample-us-1', countryCode: 'US', countryName: 'Estados Unidos', at: new Date(Date.now() - 1000 * 16).toISOString(), path: '/en' },
      { id: 'sample-ar-1', countryCode: 'AR', countryName: 'Argentina', at: new Date(Date.now() - 1000 * 24).toISOString(), path: '/' },
      { id: 'sample-es-1', countryCode: 'ES', countryName: 'Espana', at: new Date(Date.now() - 1000 * 32).toISOString(), path: '/' },
    ],
  };
  localTrafficSample.topCountries = localTrafficSample.countries.slice(0, 5);

  const api = async (path, options = {}) => {
    const response = await fetch(path, {
      credentials: 'same-origin',
      ...options,
      headers: options.body instanceof FormData
        ? options.headers
        : { 'content-type': 'application/json', ...(options.headers || {}) },
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(payload.error || 'No se pudo completar la operacion');
    return payload;
  };

  const buildMapsUrl = (address) =>
    `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.trim())}`;

  const readLocation = async () => {
    try {
      const { location } = await api('/api/settings/location');
      return location || defaultLocation;
    } catch {
      return defaultLocation;
    }
  };

  const formatSize = (bytes) => {
    if (!bytes) return '0 KB';
    if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  };

  const formatDate = (value) => {
    if (!value) return 'Sin fecha';
    return new Intl.DateTimeFormat('es-PY', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    }).format(new Date(value));
  };

  const formatRelativeTime = (value) => {
    if (!value) return 'En espera';
    const seconds = Math.max(0, Math.round((Date.now() - new Date(value).getTime()) / 1000));
    if (seconds < 60) return `Hace ${seconds || 1} s`;
    const minutes = Math.round(seconds / 60);
    if (minutes < 60) return `Hace ${minutes} min`;
    return `Hace ${Math.round(minutes / 60)} h`;
  };

  const escapeHtml = (value) =>
    String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

  const assignedProfiles = (serviceId) => {
    const ids = teamAssignments[serviceId] || [];
    return ids.map((id) => teamProfiles.find((profile) => profile.id === id)).filter(Boolean);
  };

  const getServiceName = (serviceId) =>
    document.querySelector(`[data-admin-service][data-service-id="${CSS.escape(serviceId)}"]`)?.getAttribute('data-service-name') || serviceId;

  const setText = (selector, value) => {
    const node = document.querySelector(selector);
    if (node) node.textContent = value;
  };

  const getMapCountry = (countryCode) =>
    document.querySelector(`[data-map-country="${CSS.escape(String(countryCode || '').toUpperCase())}"]`);

  const loadWorldMap = async () => {
    const container = document.querySelector('[data-world-map]');
    if (!container || mapReady) return;
    try {
      const response = await fetch('/images/world-map.svg');
      if (!response.ok) throw new Error('No se pudo cargar el mapa');
      const svgText = await response.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(svgText, 'image/svg+xml');
      const svg = doc.querySelector('svg');
      if (!svg) throw new Error('Mapa invalido');
      svg.removeAttribute('width');
      svg.removeAttribute('height');
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', 'Mapamundi político con países reales');
      svg.querySelectorAll('path[id], g[id]').forEach((node) => {
        const code = node.id?.toUpperCase();
        if (!/^[A-Z]{2}$/.test(code)) return;
        node.classList.add('admin-map-country');
        node.setAttribute('data-map-country', code);
        node.querySelectorAll('path').forEach((path) => path.classList.add('admin-map-country-part'));
      });
      container.replaceChildren(svg);
      mapReady = true;
      renderTrafficDashboard();
    } catch {
      container.innerHTML = '<div class="admin-map-loading">No se pudo cargar el mapa político.</div>';
    }
  };

  const loadTeam = async () => {
    const { profiles, assignments } = await api('/api/team-profiles');
    teamProfiles = Array.isArray(profiles) ? profiles : [];
    teamAssignments = assignments || {};
  };

  const loadTraffic = async () => {
    trafficStats = await api('/api/admin/traffic?hours=24');
  };

  const pulseMapCountryNow = (countryCode) => {
    const node = getMapCountry(countryCode);
    if (!node) return;
    const cleanCode = String(countryCode || '').toUpperCase();
    window.clearTimeout(countryPulseTimeouts.get(cleanCode));

    if (!node.classList.contains('is-breathing')) {
      node.classList.add('is-breathing');
    }

    countryPulseTimeouts.set(
      cleanCode,
      window.setTimeout(() => {
        node.classList.remove('is-breathing');
        countryPulseTimeouts.delete(cleanCode);
      }, 3600)
    );
  };

  const runTrafficPulseQueue = () => {
    if (trafficPulseTimer || !trafficPulseQueue.length) return;
    const batchSize = trafficPulseQueue.length > 8 ? 3 : 1;
    const nextBatch = trafficPulseQueue.splice(0, batchSize);
    nextBatch.forEach(pulseMapCountryNow);
    trafficPulseTimer = window.setTimeout(() => {
      trafficPulseTimer = null;
      runTrafficPulseQueue();
    }, batchSize > 1 ? 1700 : 2300);
  };

  const enqueueCountryPulse = (countryCode) => {
    const cleanCode = String(countryCode || '').toUpperCase();
    if (!cleanCode || !getMapCountry(cleanCode)) return;
    trafficPulseQueue.push(cleanCode);
    runTrafficPulseQueue();
  };

  const trafficBarMarkup = (entry, maxCount) => {
    const width = Math.max(6, Math.round((entry.count / Math.max(1, maxCount)) * 100));
    return `
      <div class="admin-traffic-row">
        <div class="admin-traffic-row-top">
          <span>${escapeHtml(entry.countryName)}</span>
          <strong>${entry.count} - ${entry.percentage.toFixed(1)}%</strong>
        </div>
        <div class="admin-traffic-track">
          <span style="width:${width}%"></span>
        </div>
      </div>
    `;
  };

  const renderTrafficDashboard = () => {
    if (!trafficStats) return;
    const countries = Array.isArray(trafficStats.countries) ? trafficStats.countries : [];
    const topCountries = Array.isArray(trafficStats.topCountries) ? trafficStats.topCountries : [];
    const recentEvents = Array.isArray(trafficStats.recentEvents) ? trafficStats.recentEvents : [];
    const maxCount = Math.max(1, ...topCountries.map((entry) => entry.count));

    setText('[data-traffic-total]', String(trafficStats.total || 0));
    setText('[data-traffic-countries]', String(countries.length));
    setText('[data-traffic-top]', topCountries[0] ? topCountries[0].countryName : 'Sin datos');
    setText('[data-traffic-last]', recentEvents[0] ? `${recentEvents[0].countryName} - ${formatRelativeTime(recentEvents[0].at)}` : 'En espera');

    document.querySelectorAll('[data-map-country]').forEach((node) => node.classList.remove('has-traffic'));

    recentEvents.forEach((event) => {
      if (seenTrafficEventIds.has(event.id)) return;
      seenTrafficEventIds.add(event.id);
      enqueueCountryPulse(event.countryCode);
    });

    const bars = document.querySelector('[data-traffic-bars]');
    if (bars) {
      bars.innerHTML = topCountries.length
        ? topCountries.map((entry) => trafficBarMarkup(entry, maxCount)).join('')
        : '<p class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-cream/45">Todavía no hay conexiones registradas.</p>';
    }

    const detail = document.querySelector('[data-traffic-detail]');
    if (detail) {
      detail.innerHTML = countries.length
        ? countries
            .map(
              (entry) => `
                <div>
                  <span>${escapeHtml(entry.countryName)}</span>
                  <strong>${entry.percentage.toFixed(1)}%</strong>
                </div>
              `
            )
            .join('')
        : '<p class="text-sm text-cream/45">Sin conexiones para detallar.</p>';
    }
  };

  const refreshTrafficDashboard = async () => {
    try {
      await loadTraffic();
      renderTrafficDashboard();
    } catch {
      setText('[data-traffic-last]', 'Sin conexion');
    }
  };

  const showLocalTrafficSample = () => {
    seenTrafficEventIds.clear();
    trafficStats = {
      ...localTrafficSample,
      countries: localTrafficSample.countries.map((entry) => ({ ...entry })),
      topCountries: localTrafficSample.topCountries.map((entry) => ({ ...entry })),
      recentEvents: localTrafficSample.recentEvents.map((event, index) => ({
        ...event,
        id: `${event.id}-${Date.now()}`,
        at: new Date(Date.now() - index * 900).toISOString(),
      })),
    };
    renderTrafficDashboard();
  };

  const startTrafficPolling = () => {
    if (trafficPoll) window.clearInterval(trafficPoll);
    trafficPoll = window.setInterval(refreshTrafficDashboard, 20000);
  };

  const stopTrafficPolling = () => {
    if (trafficPoll) window.clearInterval(trafficPoll);
    trafficPoll = null;
  };

  const renderLocation = async () => {
    const location = await readLocation();
    const isDefault = location.address === defaultLocation.address && location.mapsUrl === defaultLocation.mapsUrl;

    if (locationAddressInput) locationAddressInput.value = location.address;
    if (locationUrlPreview) {
      locationUrlPreview.href = location.mapsUrl;
      locationUrlPreview.textContent = location.mapsUrl;
    }
    if (locationOpen) locationOpen.href = location.mapsUrl;
    if (locationStatus) {
      locationStatus.textContent = isDefault
        ? 'Usando la dirección original del sitio.'
        : `Guardado en el servidor - ${formatDate(location.updatedAt)}`;
    }
  };

  const renderDashboard = () => {
    const serviceEntries = Array.from(document.querySelectorAll('[data-admin-service]')).map((card) => {
      const serviceId = card.getAttribute('data-service-id');
      return {
        id: serviceId,
        name: card.getAttribute('data-service-name') || serviceId,
        count: (teamAssignments[serviceId] || []).length,
      };
    });

    const covered = serviceEntries.filter((entry) => entry.count > 0).length;
    const storageUsed = teamProfiles.reduce((sum, profile) => sum + (profile.size || 0), 0);
    const maxCount = Math.max(1, ...serviceEntries.map((entry) => entry.count));
    const topService = serviceEntries.reduce((best, entry) => (entry.count > best.count ? entry : best), { name: 'Sin datos', count: 0 });
    const lastUpload = [...teamProfiles]
      .filter((profile) => profile.updatedAt || profile.uploadedAt)
      .sort((a, b) => new Date(b.updatedAt || b.uploadedAt).getTime() - new Date(a.updatedAt || a.uploadedAt).getTime())[0];

    setText('[data-total-profiles]', String(teamProfiles.length));
    setText('[data-covered-services]', String(covered));
    setText('[data-storage-used]', `${formatSize(storageUsed)} usados`);
    setText('[data-top-service]', topService.count ? `${topService.name} (${topService.count})` : 'Sin datos');
    setText(
      '[data-last-upload]',
      lastUpload ? `${lastUpload.name} - ${formatDate(lastUpload.updatedAt || lastUpload.uploadedAt)}` : 'Sin cargas todavía'
    );
    setText('[data-profile-library-count]', `${teamProfiles.length} ${teamProfiles.length === 1 ? 'perfil' : 'perfiles'}`);

    document.querySelectorAll('[data-chart-row]').forEach((row) => {
      const serviceId = row.getAttribute('data-service-id');
      const count = (teamAssignments[serviceId] || []).length;
      const percent = Math.round((count / maxCount) * 100);
      row.querySelector('[data-chart-count]').textContent = String(count);
      row.querySelector('[data-chart-bar]').style.width = `${percent}%`;
    });
  };

  const assignedPreviewMarkup = (profile) => `
    <span class="admin-assigned-chip">
      <span class="admin-assigned-dot" aria-hidden="true"></span>
      <span>${escapeHtml(profile.name)}</span>
    </span>
  `;

  const profileMenuOptionMarkup = (profile, selected) => `
    <label class="admin-assign-option">
      <input type="checkbox" value="${escapeHtml(profile.id)}" ${selected ? 'checked' : ''} data-service-profile-checkbox />
      <span>${escapeHtml(profile.name)}</span>
    </label>
  `;

  const renderProfiles = () => {
    const list = document.querySelector('[data-profile-list]');
    const template = document.querySelector('[data-profile-card-template]');
    if (!list || !template) return;
    list.innerHTML = '';

    if (!teamProfiles.length) {
      list.innerHTML = '<p class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-cream/45">Todavía no hay integrantes cargados.</p>';
      return;
    }

    teamProfiles.forEach((profile) => {
      const fragment = template.content.cloneNode(true);
      const card = fragment.querySelector('[data-profile-card]');
      const form = fragment.querySelector('[data-profile-form]');
      card.dataset.profileId = profile.id;
      form.dataset.profileId = profile.id;
      fragment.querySelector('[data-profile-image]').src = profile.imageUrl || '/images/logoAVC.jpeg';
      fragment.querySelector('[data-profile-image]').alt = profile.name;
      form.elements.name.value = profile.name || '';
      form.elements.role.value = profile.role || '';
      form.elements.specialty.value = profile.specialty || '';
      form.elements.description.value = profile.description || '';
      list.appendChild(fragment);
    });
  };

  const renderServiceAssignments = () => {
    document.querySelectorAll('[data-admin-service]').forEach((card) => {
      const serviceId = card.getAttribute('data-service-id');
      const selectedIds = new Set(teamAssignments[serviceId] || []);
      const menuOptions = card.querySelector('[data-profile-menu-options]');
      const preview = card.querySelector('[data-assigned-preview]');
      const countNode = card.querySelector('[data-service-count]');
      const selectedProfiles = assignedProfiles(serviceId);

      if (countNode) {
        countNode.textContent = `${selectedProfiles.length} ${selectedProfiles.length === 1 ? 'integrante' : 'integrantes'}`;
      }
      if (menuOptions) {
        menuOptions.innerHTML = teamProfiles.length
          ? teamProfiles
              .map((profile) => profileMenuOptionMarkup(profile, selectedIds.has(profile.id)))
              .join('')
          : '<p class="px-3 py-2 text-sm text-cream/45">Carga integrantes para poder asignarlos.</p>';
      }
      if (preview) {
        preview.innerHTML = selectedProfiles.length
          ? selectedProfiles.map(assignedPreviewMarkup).join('')
          : '<p class="text-sm text-cream/45">Sin colaboradores asignados.</p>';
      }
    });
  };

  const renderAdmin = async () => {
    await Promise.all([loadTeam(), loadTraffic().catch(() => null), loadWorldMap()]);
    renderProfiles();
    renderServiceAssignments();
    renderDashboard();
    renderTrafficDashboard();
    await renderLocation();
  };

  const showAdmin = async (user) => {
    currentUser = user;
    loginScreen?.classList.add('hidden');
    adminApp?.classList.remove('hidden');
    setText('[data-session-user]', user?.name || user?.username || 'admin');
    await renderAdmin();
    startTrafficPolling();
  };

  const showLogin = () => {
    stopTrafficPolling();
    adminApp?.classList.add('hidden');
    loginScreen?.classList.remove('hidden');
  };

  const bootstrap = async () => {
    try {
      const { user } = await api('/api/auth/me');
      await showAdmin(user);
    } catch {
      showLogin();
    }
  };

  bootstrap();

  if (['localhost', '127.0.0.1', '::1'].includes(location.hostname)) {
    document.querySelector('[data-traffic-demo]')?.removeAttribute('hidden');
  }

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(loginForm);
    const username = String(formData.get('username') || '').trim();
    const password = String(formData.get('password') || '');

    try {
      const { user } = await api('/api/auth/login', {
        method: 'POST',
        body: JSON.stringify({ username, password }),
      });
      loginError?.classList.add('hidden');
      await showAdmin(user);
    } catch {
      loginError?.classList.remove('hidden');
    }
  });

  document.querySelector('[data-logout]')?.addEventListener('click', async () => {
    await api('/api/auth/logout', { method: 'POST', body: '{}' }).catch(() => null);
    currentUser = null;
    showLogin();
  });

  document.querySelector('[data-traffic-toggle]')?.addEventListener('click', (event) => {
    const button = event.currentTarget;
    const detail = document.querySelector('[data-traffic-detail]');
    if (!detail) return;
    const nextExpanded = detail.hasAttribute('hidden');
    detail.toggleAttribute('hidden', !nextExpanded);
    button.setAttribute('aria-expanded', String(nextExpanded));
    button.textContent = nextExpanded ? 'Ocultar detalle por país' : 'Ver porcentaje exacto por país';
  });

  document.querySelector('[data-traffic-demo]')?.addEventListener('click', showLocalTrafficSample);

  document.querySelector('[data-new-profile-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    try {
      await api('/api/admin/team-profiles', { method: 'POST', body: new FormData(form) });
      form.reset();
      await renderAdmin();
    } catch (error) {
      alert(error.message || 'No se pudo crear el integrante.');
    }
  });

  document.addEventListener('submit', async (event) => {
    const form = event.target.closest('[data-profile-form]');
    if (!form) return;
    event.preventDefault();
    const profileId = form.dataset.profileId;
    try {
      await api(`/api/admin/team-profiles/${encodeURIComponent(profileId)}`, { method: 'PUT', body: new FormData(form) });
      await renderAdmin();
    } catch (error) {
      alert(error.message || 'No se pudo guardar el perfil.');
    }
  });

  document.addEventListener('change', async (event) => {
    const checkbox = event.target.closest('[data-service-profile-checkbox]');
    if (!checkbox) return;
    const card = checkbox.closest('[data-admin-service]');
    const serviceId = card?.getAttribute('data-service-id');
    const profileIds = Array.from(card.querySelectorAll('[data-service-profile-checkbox]:checked')).map((input) => input.value);
    try {
      const payload = await api('/api/admin/service-profiles', {
        method: 'PUT',
        body: JSON.stringify({ serviceId, profileIds }),
      });
      teamProfiles = payload.profiles || teamProfiles;
      teamAssignments = payload.assignments || teamAssignments;
      renderServiceAssignments();
      renderDashboard();
    } catch (error) {
      alert(error.message || 'No se pudo actualizar el servicio.');
      await renderAdmin();
    }
  });

  document.addEventListener('click', async (event) => {
    const deleteButton = event.target.closest('[data-delete-profile]');
    if (!deleteButton) return;
    const form = deleteButton.closest('[data-profile-form]');
    const profileId = form?.dataset.profileId;
    if (!profileId || !confirm('Quieres eliminar este integrante y quitarlo de los servicios?')) return;
    await api(`/api/admin/team-profiles/${encodeURIComponent(profileId)}`, { method: 'DELETE' });
    await renderAdmin();
  });

  locationAddressInput?.addEventListener('input', () => {
    const address = locationAddressInput.value.trim() || defaultLocation.address;
    const mapsUrl = buildMapsUrl(address);

    if (locationUrlPreview) {
      locationUrlPreview.href = mapsUrl;
      locationUrlPreview.textContent = mapsUrl;
    }
    if (locationOpen) locationOpen.href = mapsUrl;
    if (locationStatus) locationStatus.textContent = 'Vista previa sin guardar.';
  });

  locationForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const address = locationAddressInput?.value.trim();

    if (!address) {
      alert('Escribe una dirección para generar el enlace de Google Maps.');
      locationAddressInput?.focus();
      return;
    }

    await api('/api/admin/settings/location', {
      method: 'PUT',
      body: JSON.stringify({
        address,
        mapsUrl: buildMapsUrl(address),
      }),
    });
    await renderLocation();
  });

  document.querySelector('[data-location-reset]')?.addEventListener('click', async () => {
    await api('/api/admin/settings/location', { method: 'DELETE' });
    await renderLocation();
  });
</script>

<style>
  .admin-shell {
    font-family: var(--font-sans);
  }

  :global(.admin-shell ~ .whatsapp-floating) {
    display: none;
  }

  .admin-login-screen.hidden,
  [data-admin-app].hidden {
    display: none;
  }

  .admin-login-screen {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: 1.25rem;
    background:
      radial-gradient(45rem 32rem at 74% 8%, rgba(212, 175, 55, 0.16), transparent),
      linear-gradient(135deg, rgba(255, 255, 255, 0.055), transparent 36%),
      var(--color-ink-950);
  }

  .admin-login-card,
  .admin-panel,
  .admin-metric {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: 0 28px 90px -42px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(12px);
  }

  .admin-login-card {
    width: min(100%, 27rem);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .admin-back-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-gold-300);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .admin-back-link:hover {
    color: var(--color-gold-200);
  }

  .admin-section-kicker {
    display: flex;
    width: fit-content;
    margin-top: 1.65rem;
    line-height: 1.25;
  }

  .admin-input {
    width: 100%;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    background: rgba(11, 11, 15, 0.58);
    padding: 0.85rem 0.95rem;
    color: var(--color-cream);
    outline: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .admin-input:focus {
    border-color: color-mix(in srgb, var(--color-gold-400) 65%, transparent);
    background: rgba(11, 11, 15, 0.78);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.14);
  }

  .admin-file {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    background: rgba(11, 11, 15, 0.58);
    padding: 0.7rem;
    color: rgba(247, 245, 240, 0.7);
    font-size: 0.76rem;
  }

  .admin-file::file-selector-button {
    max-width: 8.6rem;
    border: 0;
    border-radius: 0.65rem;
    background: rgba(212, 175, 55, 0.16);
    color: var(--color-gold-200);
    font-weight: 800;
    margin-right: 0.55rem;
    padding: 0.42rem 0.55rem;
  }

  .admin-profile-card,
  .admin-service-assignment {
    min-width: 0;
    border-radius: 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.035);
    padding: 1rem;
  }

  .admin-profile-card {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.025)),
      rgba(255, 255, 255, 0.025);
  }

  .admin-profile-edit-grid {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.65fr) minmax(0, 1.35fr);
    gap: 1rem;
    align-items: start;
  }

  .admin-profile-media {
    min-width: 0;
    overflow: hidden;
  }

  .admin-profile-fields {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  .admin-profile-image {
    display: block;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 1rem;
    border: 1px solid rgba(212, 175, 55, 0.2);
    background: rgba(11, 11, 15, 0.72);
    object-fit: cover;
  }

  .admin-service-preview {
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(212, 175, 55, 0.16);
    background:
      radial-gradient(42rem 18rem at 94% -20%, rgba(212, 175, 55, 0.12), transparent),
      rgba(255, 255, 255, 0.035);
    padding: 1rem;
  }

  :global(.admin-assigned-chip) {
    display: flex;
    width: fit-content;
    max-width: min(100%, 24rem);
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.85rem;
    border: 1px solid rgba(212, 175, 55, 0.22);
    background:
      linear-gradient(135deg, rgba(212, 175, 55, 0.12), rgba(255, 255, 255, 0.035)),
      rgba(255, 255, 255, 0.035);
    padding: 0.5rem 0.72rem;
    color: rgba(247, 245, 240, 0.82);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.25;
  }

  :global(.admin-assigned-dot) {
    width: 0.42rem;
    height: 0.42rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-gold-300);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.12);
  }

  [data-assigned-preview] {
    display: grid;
    gap: 0.55rem;
  }

  .admin-assign-menu {
    position: relative;
  }

  .admin-assign-menu summary {
    display: inline-flex;
    width: fit-content;
    cursor: pointer;
    list-style: none;
    align-items: center;
    gap: 0.45rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.42);
    background: rgba(212, 175, 55, 0.1);
    padding: 0.65rem 0.9rem;
    color: var(--color-gold-200);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
