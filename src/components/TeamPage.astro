---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { getContent, social, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getContent(lang);

const copy = {
  es: {
    pageLabel: 'Equipo',
    eyebrow: 'Equipo profesional',
    title: 'Personas expertas para cada etapa de tu empresa',
    lead:
      'Conoce a los profesionales que sostienen nuestras soluciones contables, tributarias, financieras y empresariales.',
    contact: 'Contactenos',
    directoryTitle: 'Nuestro equipo',
    directoryLead: 'Selecciona un perfil para ver su trayectoria y areas de especializacion.',
    viewProfile: 'Ver perfil',
    loading: 'Cargando perfiles del equipo...',
    empty: 'Todavia no hay integrantes cargados.',
    quote: 'Acompanamos cada decision con criterio tecnico, cercania y foco en resultados.',
    quoteBy: 'AVC Soluciones Empresariales',
    profileFallback: 'Perfil profesional',
  },
  en: {
    pageLabel: 'Team',
    eyebrow: 'Professional team',
    title: 'Experts for every stage of your company',
    lead:
      'Meet the professionals behind our accounting, tax, financial and business advisory solutions.',
    contact: 'Contact us',
    directoryTitle: 'Our team',
    directoryLead: 'Select a profile to view background and areas of expertise.',
    viewProfile: 'View profile',
    loading: 'Loading team profiles...',
    empty: 'No team members have been added yet.',
    quote: 'We support every decision with technical judgment, closeness and a focus on results.',
    quoteBy: 'AVC Soluciones Empresariales',
    profileFallback: 'Professional profile',
  },
  pt: {
    pageLabel: 'Equipe',
    eyebrow: 'Equipe profissional',
    title: 'Especialistas para cada etapa da sua empresa',
    lead:
      'Conheca os profissionais por tras das nossas solucoes contabeis, tributarias, financeiras e empresariais.',
    contact: 'Fale conosco',
    directoryTitle: 'Nossa equipe',
    directoryLead: 'Selecione um perfil para ver sua trajetoria e areas de especializacao.',
    viewProfile: 'Ver perfil',
    loading: 'Carregando perfis da equipe...',
    empty: 'Ainda nao ha integrantes cadastrados.',
    quote: 'Acompanhamos cada decisao com criterio tecnico, proximidade e foco em resultados.',
    quoteBy: 'AVC Soluciones Empresariales',
    profileFallback: 'Perfil profissional',
  },
}[lang];
---

<Header lang={lang} />

<main class="team-page bg-cream" data-team-page>
  <section class="team-hero bg-ink-950 text-cream">
    <div class="team-hero-glow" aria-hidden="true"></div>
    <div class="container-x team-hero-inner">
      <div class="team-hero-copy reveal">
        <span class="eyebrow !text-gold-300">
          <Icon name="users" class="w-4 h-4" />{copy.eyebrow}
        </span>
        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl leading-[1.04]" data-team-hero-name>
          {copy.title}
        </h1>
        <p class="mt-4 text-lg text-cream/72 leading-relaxed" data-team-hero-role>
          {copy.lead}
        </p>
        <p class="mt-3 max-w-2xl text-sm text-gold-300/86 font-semibold" data-team-hero-specialty></p>
        <a href={social.whatsapp} target="_blank" rel="noopener" class="btn btn-gold mt-8">
          <Icon name="whatsapp" class="w-5 h-5" />{copy.contact}
        </a>
      </div>

      <div class="team-hero-media reveal" data-team-hero-media hidden>
        <img src="/images/logo-icon.png" alt="" data-team-hero-image />
      </div>
    </div>
  </section>

  <section class="team-directory">
    <div class="container-x">
      <article class="team-detail reveal" id="perfil" data-team-detail hidden>
        <div class="team-detail-copy">
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-600" data-team-detail-specialty></p>
          <h2 class="mt-3 text-3xl sm:text-4xl" data-team-detail-name></h2>
          <p class="mt-2 text-lg font-semibold text-ink-700" data-team-detail-role></p>
          <div class="team-detail-description" data-team-detail-description></div>
        </div>

        <aside class="team-quote">
          <div class="team-quote-mark" aria-hidden="true">"</div>
          <p>{copy.quote}</p>
          <span data-team-quote-by>{copy.quoteBy}</span>
        </aside>
      </article>

      <div class="team-directory-heading reveal">
        <div>
          <span class="eyebrow">{copy.pageLabel}</span>
          <h2 class="mt-3 text-3xl sm:text-4xl">{copy.directoryTitle}</h2>
          <p>{copy.directoryLead}</p>
        </div>
      </div>

      <p class="team-status reveal" data-team-status>{copy.loading}</p>

      <div class="team-grid" data-team-grid></div>
    </div>
  </section>
</main>

<Footer lang={lang} />

<script define:vars={{ copy }}>
  let teamProfiles = [];
  let activeProfileId = '';
  let descriptionTypingToken = 0;
  let profileFlightToken = 0;

  const statusNode = document.querySelector('[data-team-status]');
  const gridNode = document.querySelector('[data-team-grid]');
  const detailNode = document.querySelector('[data-team-detail]');
  const teamPage = document.querySelector('[data-team-page]');
  const heroMedia = document.querySelector('[data-team-hero-media]');
  const heroName = document.querySelector('[data-team-hero-name]');
  const heroRole = document.querySelector('[data-team-hero-role]');
  const heroSpecialty = document.querySelector('[data-team-hero-specialty]');
  const heroImage = document.querySelector('[data-team-hero-image]');
  const detailName = document.querySelector('[data-team-detail-name]');
  const detailRole = document.querySelector('[data-team-detail-role]');
  const detailSpecialty = document.querySelector('[data-team-detail-specialty]');
  const detailDescription = document.querySelector('[data-team-detail-description]');
  const quoteBy = document.querySelector('[data-team-quote-by]');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const escapeHtml = (value) =>
    String(value || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

  const getProfileHref = (profileId) => `${window.location.pathname}?perfil=${encodeURIComponent(profileId)}`;

  const splitDescription = (description) => {
    const text = String(description || '').trim();
    if (!text) return [];
    const sentences = text.match(/[^.!?]+[.!?]+|[^.!?]+$/g) || [text];
    const paragraphs = [];
    for (let index = 0; index < sentences.length; index += 2) {
      paragraphs.push(sentences.slice(index, index + 2).join(' ').trim());
    }
    return paragraphs;
  };

  const getSelectedProfile = () => {
    const params = new URLSearchParams(window.location.search);
    const requested = params.get('perfil') || window.location.hash.replace('#', '');
    if (!requested) return null;
    return teamProfiles.find((profile) => profile.id === requested) || null;
  };

  const handleProfileLinkClick = (event) => {
    const clickedElement = event.currentTarget instanceof Element
      ? event.currentTarget
      : event.target instanceof Element
        ? event.target
        : event.target?.parentElement;
    const link = clickedElement?.closest('a[href]');
    if (!link) return;
    const card = link.closest('[data-team-card]');
    const profileId = card?.getAttribute('data-profile-id');
    if (!profileId) return;
    event.preventDefault();
    setActiveProfile(profileId, true, card.querySelector('img'), card);
  };

  const renderGrid = () => {
    if (!gridNode) return;
    gridNode.innerHTML = teamProfiles
      .map((profile) => {
        const role = profile.specialty || profile.role || copy.profileFallback;
        const isActive = profile.id === activeProfileId;
        return `
          <article class="team-card ${isActive ? 'is-active' : ''}" data-team-card data-profile-id="${escapeHtml(profile.id)}">
            <a href="${getProfileHref(profile.id)}" class="team-card-image-link" aria-label="${escapeHtml(copy.viewProfile)}: ${escapeHtml(profile.name)}">
              <img src="${escapeHtml(profile.imageUrl || '/images/logo-icon.png')}" alt="${escapeHtml(profile.name)}" />
            </a>
            <div class="team-card-body">
              <h3>${escapeHtml(profile.name)}</h3>
              <p>${escapeHtml(role)}</p>
              <a href="${getProfileHref(profile.id)}" class="team-profile-link" data-profile-link>
                ${escapeHtml(copy.viewProfile)}
              </a>
            </div>
          </article>
        `;
      })
      .join('');

    gridNode.querySelectorAll('[data-team-card] a[href]').forEach((link) => {
      link.addEventListener('click', handleProfileLinkClick);
    });
  };

  const renderDescription = (description) => {
    descriptionTypingToken += 1;
    detailDescription.classList.remove('is-typing');
    detailDescription.innerHTML = splitDescription(description)
      .map((paragraph) => `<p>${escapeHtml(paragraph)}</p>`)
      .join('');
  };

  const typeDescription = (description) => {
    const paragraphs = splitDescription(description);
    const typingToken = ++descriptionTypingToken;
    detailDescription.innerHTML = '';
    detailDescription.classList.add('is-typing');

    if (!paragraphs.length || prefersReducedMotion.matches) {
      renderDescription(description);
      return;
    }

    const paragraphNodes = paragraphs.map(() => {
      const node = document.createElement('p');
      detailDescription.appendChild(node);
      return node;
    });
    const fullText = paragraphs.join('\n');
    const duration = Math.min(5200, Math.max(2200, fullText.length * 11));
    const startedAt = performance.now();

    const typeFrame = (now) => {
      if (typingToken !== descriptionTypingToken) return;
      const progress = Math.min(1, (now - startedAt) / duration);
      let remainingCharacters = Math.floor(fullText.length * progress);

      paragraphs.forEach((paragraph, index) => {
        const visibleCharacters = Math.min(paragraph.length, Math.max(0, remainingCharacters));
        paragraphNodes[index].textContent = paragraph.slice(0, visibleCharacters);
        remainingCharacters -= paragraph.length + 1;
      });

      if (progress < 1) {
        requestAnimationFrame(typeFrame);
      } else {
        detailDescription.classList.remove('is-typing');
      }
    };

    requestAnimationFrame(typeFrame);
  };

  const renderProfile = (profile, { deferDescription = false } = {}) => {
    activeProfileId = profile?.id || '';
    renderGrid();
    if (!profile) return;

    teamPage?.classList.remove('is-neutral');
    if (heroMedia) heroMedia.hidden = false;
    const role = profile.role || copy.profileFallback;
    const specialty = profile.specialty || role;
    heroName.textContent = profile.name || copy.directoryTitle;
    heroRole.textContent = role;
    heroSpecialty.textContent = specialty;
    heroImage.src = profile.imageUrl || '/images/logo-icon.png';
    heroImage.alt = profile.name || '';

    detailName.textContent = profile.name || '';
    detailRole.textContent = role;
    detailSpecialty.textContent = specialty;
    quoteBy.textContent = `${profile.name || copy.quoteBy} - ${specialty}`;
    descriptionTypingToken += 1;
    detailDescription.classList.remove('is-typing');
    detailDescription.innerHTML = deferDescription ? '' : splitDescription(profile.description)
      .map((paragraph) => `<p>${escapeHtml(paragraph)}</p>`)
      .join('');
    detailNode.hidden = false;
    requestAnimationFrame(() => detailNode.classList.add('is-visible', 'is-settled'));
  };

  const renderNeutralTeam = () => {
    descriptionTypingToken += 1;
    profileFlightToken += 1;
    activeProfileId = '';
    teamPage?.classList.add('is-neutral');
    heroName.textContent = copy.title;
    heroRole.textContent = copy.lead;
    heroSpecialty.textContent = '';
    if (heroMedia) heroMedia.hidden = true;
    if (detailNode) {
      detailNode.classList.remove('is-visible', 'is-settled');
      detailNode.hidden = true;
    }
    renderGrid();
  };

  const animateProfileImageToHero = (sourceRect, sourceSrc, finalScrollTop = window.scrollY) => {
    if (!sourceRect || !sourceSrc || !heroMedia || !heroImage || prefersReducedMotion.matches) {
      return Promise.resolve(false);
    }

    const flightToken = ++profileFlightToken;
    const startScrollTop = window.scrollY;
    const targetScrollTop = Math.max(0, finalScrollTop);
    const targetRect = heroMedia.getBoundingClientRect();
    if (!targetRect.width || !targetRect.height) return Promise.resolve(false);

    const targetDocumentTop = targetRect.top + startScrollTop;
    const targetViewportTop = targetDocumentTop - targetScrollTop;
    const isCompactViewport = window.matchMedia('(max-width: 640px)').matches;
    const duration = isCompactViewport ? 1500 : 1900;

    const ghost = document.createElement('div');
    ghost.className = 'team-profile-flight';
    ghost.setAttribute('aria-hidden', 'true');
    const cloth = document.createElement('div');
    cloth.className = 'team-profile-cloth';
    const clothStrips = Array.from({ length: 9 }, (_, index) => {
      const strip = document.createElement('span');
      strip.className = 'team-profile-cloth-strip';
      strip.style.setProperty('--strip-index', index);
      const stripImage = document.createElement('img');
      stripImage.src = sourceSrc;
      stripImage.alt = '';
      stripImage.style.left = `${index * -100}%`;
      strip.appendChild(stripImage);
      cloth.appendChild(strip);
      return strip;
    });
    ghost.appendChild(cloth);
    Object.assign(ghost.style, {
      left: `${sourceRect.left}px`,
      top: `${sourceRect.top}px`,
      width: `${sourceRect.width}px`,
      height: `${sourceRect.height}px`,
    });

    document.querySelectorAll('.team-profile-flight').forEach((node) => node.remove());
    document.body.appendChild(ghost);
    heroMedia.classList.add('is-receiving-profile');
    const rootStyle = document.documentElement.style;
    const previousScrollBehavior = rootStyle.scrollBehavior;
    rootStyle.scrollBehavior = 'auto';
    const startedAt = performance.now();
    const easeInOut = (value) => value < 0.5
      ? 4 * value * value * value
      : 1 - Math.pow(-2 * value + 2, 3) / 2;
    const easeOut = (value) => 1 - Math.pow(1 - value, 3);
    const interpolate = (start, end, progress) => start + (end - start) * progress;

    return new Promise((resolve) => {
      const finishFlight = (completed) => {
        rootStyle.scrollBehavior = previousScrollBehavior;
        ghost.remove();
        heroMedia.classList.remove('is-receiving-profile');
        if (completed) {
          heroMedia.classList.add('is-profile-settled');
          window.setTimeout(() => heroMedia.classList.remove('is-profile-settled'), 420);
        }
        resolve(completed);
      };

      const flightFrame = (now) => {
        if (flightToken !== profileFlightToken) {
          finishFlight(false);
          return;
        }

        const rawProgress = Math.min(1, (now - startedAt) / duration);
        const progress = easeInOut(rawProgress);
        const scrollProgress = easeOut(Math.min(1, rawProgress / 0.74));
        const clothLift = Math.sin(Math.PI * progress);
        const motionScale = isCompactViewport ? 0.62 : 1;
        const arc = clothLift * Math.min(isCompactViewport ? 46 : 84, window.innerHeight * 0.09);
        const currentScrollTop = interpolate(startScrollTop, targetScrollTop, scrollProgress);
        const currentTop = interpolate(sourceRect.top, targetViewportTop, progress) - arc;
        const wrinkle = clothLift * (1 - rawProgress * 0.2);
        const clothMotion = Math.max(0, Math.min(1, (rawProgress - 0.035) / 0.965));
        const sway = Math.sin(clothMotion * Math.PI * 2.4) * wrinkle;
        const rotate = sway * 4.6;
        const skew = sway * 5.2;
        const scaleX = 1 + wrinkle * 0.038;
        const scaleY = 1 - wrinkle * 0.026;
        const foldStrength = wrinkle.toFixed(3);
        const clothPhase = clothMotion * Math.PI * 3.8;

        window.scrollTo(0, currentScrollTop);
        clothStrips.forEach((strip, index) => {
          const distanceFromCenter = (index - 4) / 4;
          const wave = Math.sin(clothPhase + index * 0.72) * wrinkle;
          const secondaryWave = Math.cos(clothPhase * 0.72 + index * 0.45) * wrinkle;
          const lift = (wave * 18 - Math.abs(distanceFromCenter) * wrinkle * 7) * motionScale;
          const pinch = Math.cos(clothPhase + index * 0.6) * wrinkle * 3.5 * motionScale;
          strip.style.transform = `translate3d(${pinch}px, ${lift}px, ${wave * 18 * motionScale}px) rotateY(${distanceFromCenter * wrinkle * -34 * motionScale}deg) rotateZ(${wave * 4.8 * motionScale}deg) skewY(${secondaryWave * 4.5 * motionScale}deg) scaleY(${1 + secondaryWave * 0.055 * motionScale})`;
          strip.style.filter = `brightness(${1 + wave * 0.16}) contrast(${1 + wrinkle * 0.07})`;
          strip.style.clipPath = `polygon(0 ${Math.max(0, 2 + wave * 5)}%, 100% ${Math.max(0, 1 - secondaryWave * 4)}%, 100% ${Math.min(100, 99 + wave * 3)}%, 0 ${Math.min(100, 98 - secondaryWave * 5)}%)`;
        });
        Object.assign(ghost.style, {
          left: `${interpolate(sourceRect.left, targetRect.left, progress)}px`,
          top: `${currentTop}px`,
          width: `${interpolate(sourceRect.width, targetRect.width, progress)}px`,
          height: `${interpolate(sourceRect.height, targetRect.height, progress)}px`,
          borderRadius: `${interpolate(4, 12, progress)}px`,
          transform: `perspective(920px) rotate(${rotate * motionScale}deg) rotateX(${wrinkle * 7 * motionScale}deg) rotateY(${sway * -8 * motionScale}deg) skew(${skew * motionScale}deg, ${sway * -1.8 * motionScale}deg) scale(${scaleX}, ${scaleY})`,
          filter: `brightness(${interpolate(1.02, 1.055, progress)}) saturate(${interpolate(1.02, 1.08, progress)})`,
          '--cloth-fold': foldStrength,
          '--cloth-sway': `${sway.toFixed(3)}`,
        });

        if (rawProgress < 1) requestAnimationFrame(flightFrame);
        else finishFlight(true);
      };

      requestAnimationFrame(flightFrame);
    });
  };

  const setActiveProfile = async (profileId, shouldScroll = true, sourceImage = null, sourceFallback = null) => {
    const profile = teamProfiles.find((item) => item.id === profileId) || teamProfiles[0] || null;
    if (!profile) return;
    const sourceFrame = sourceImage?.closest?.('.team-card-image-link') || sourceImage || sourceFallback;
    const sourceBox = sourceFrame?.getBoundingClientRect();
    const sourceRect = sourceBox
      ? {
          left: sourceBox.left,
          top: sourceBox.top,
          width: sourceBox.width,
          height: sourceBox.height,
        }
      : null;
    const sourceSrc = sourceImage?.currentSrc || sourceImage?.src || profile.imageUrl;
    history.replaceState(null, '', getProfileHref(profile.id));
    const shouldAnimate = shouldScroll && !prefersReducedMotion.matches;
    renderProfile(profile, { deferDescription: shouldAnimate });
    if (shouldScroll) {
      const heroNode = document.querySelector('.team-hero');
      const finalScrollTop = heroNode ? Math.max(0, window.scrollY + heroNode.getBoundingClientRect().top) : 0;
      const completed = await animateProfileImageToHero(sourceRect, sourceSrc, finalScrollTop);
      if (!completed) heroNode?.scrollIntoView({ behavior: prefersReducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
      if (shouldAnimate && profile.id === activeProfileId) typeDescription(profile.description);
    } else {
      await animateProfileImageToHero(sourceRect, sourceSrc);
    }
  };

  const loadTeam = async () => {
    try {
      const response = await fetch('/api/team-profiles');
      if (!response.ok) throw new Error('No team profiles');
      const payload = await response.json();
      teamProfiles = Array.isArray(payload.profiles) ? payload.profiles : [];
    } catch {
      teamProfiles = [];
    }

    if (!teamProfiles.length) {
      if (statusNode) statusNode.textContent = copy.empty;
      return;
    }

    if (statusNode) statusNode.hidden = true;
    const selectedProfile = getSelectedProfile();
    if (selectedProfile) {
      renderProfile(selectedProfile);
    } else {
      renderNeutralTeam();
    }
  };

  gridNode?.addEventListener('click', (event) => {
    if (event.defaultPrevented) return;
    const clickedElement = event.target instanceof Element ? event.target : event.target?.parentElement;
    const link = clickedElement?.closest('a[href]');
    if (!link) return;
    const card = link.closest('[data-team-card]');
    const profileId = card?.getAttribute('data-profile-id');
    if (!profileId) return;
    event.preventDefault();
    setActiveProfile(profileId, true, card.querySelector('img'), card);
  });

  window.addEventListener('popstate', () => {
    const selectedProfile = getSelectedProfile();
    if (selectedProfile) renderProfile(selectedProfile);
    else renderNeutralTeam();
  });
  loadTeam();
</script>

<style>
  .team-page {
    min-height: 100vh;
  }

  .team-hero {
    position: relative;
    overflow: hidden;
    padding-top: 6.5rem;
  }

  .team-hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(46rem 34rem at 78% 12%, rgba(212, 175, 55, 0.16), transparent),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 54%);
    pointer-events: none;
  }

  .team-hero-inner {
    position: relative;
    display: grid;
    min-height: 28rem;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 5.4rem);
  }

  .team-hero-copy {
    max-width: 42rem;
  }

  .team-page.is-neutral .team-hero-inner {
    grid-template-columns: minmax(0, 44rem);
  }

  .team-page.is-neutral .team-hero-copy {
    max-width: 44rem;
  }

  .team-hero-media {
    overflow: hidden;
    border-radius: 0.75rem;
    aspect-ratio: 7 / 6;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 28px 70px -36px rgba(0, 0, 0, 0.95);
  }

  .team-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .team-directory {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .team-directory-heading {
    max-width: 44rem;
  }

  .team-detail:not([hidden]) + .team-directory-heading {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .team-directory-heading p {
    margin-top: 0.85rem;
    max-width: 31rem;
    color: var(--color-ink-600);
    line-height: 1.7;
  }

  .team-status {
    margin-top: 2rem;
    border-radius: 1rem;
    border: 1px solid rgba(11, 11, 15, 0.08);
    background: white;
    padding: 1rem;
    color: var(--color-ink-600);
    box-shadow: var(--shadow-soft);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  :global(.team-card) {
    display: flex;
    min-height: 22.25rem;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0.6rem;
    border: 1px solid rgba(11, 11, 15, 0.08);
    background: white;
    box-shadow: 0 14px 34px -26px rgba(11, 11, 15, 0.48);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  :global(.team-card:hover),
  :global(.team-card.is-active) {
    transform: translateY(-2px);
    border-color: rgba(212, 175, 55, 0.42);
    box-shadow: 0 22px 48px -28px rgba(11, 11, 15, 0.55);
  }

  :global(.team-card-image-link) {
    display: block;
    aspect-ratio: 1.45 / 1;
    overflow: hidden;
    background: var(--color-ink-900);
  }

  :global(.team-card img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.team-card:hover img) {
    transform: scale(1.035);
  }

  :global(.team-card-body) {
    display: flex;
    flex: 1;
    min-height: 10.75rem;
    flex-direction: column;
    padding: 1rem;
  }

  :global(.team-card h3) {
    color: var(--color-ink-900);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.15;
  }

  :global(.team-card p) {
